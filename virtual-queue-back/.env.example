SPRING_PROFILES_ACTIVE=dev
# Prefer Session pooler (IPv4). Dashboard: Database → Connection string → Session mode.
# Direct db.<ref>.supabase.co is IPv6-only and often fails on Windows/Java.
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.<PROJECT_REF>
SUPABASE_DB_PASSWORD=<SUPABASE_DB_PASSWORD>
SUPABASE_DB_POOL_MAX_SIZE=5
JWT_SECRET=<JWT_SECRET_AT_LEAST_32_CHARS>
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
FIREBASE_CREDENTIALS_PATH=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
STAFF_REGISTRATION_KEY_PEPPER=<RANDOM_SECRET_AT_LEAST_32_CHARS>
